# 统一换行符，避免 Windows / macOS 之间产生成片的假 diff
* text=auto eol=lf

# 代码与配置：强制 LF
*.gd        text eol=lf
*.tscn      text eol=lf
*.tres      text eol=lf
*.godot     text eol=lf
*.cfg       text eol=lf
*.import    text eol=lf
*.svg       text eol=lf
*.md        text eol=lf
*.py        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.csv       text eol=lf
*.txt       text eol=lf

# Windows 脚本保持 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# ============ 二进制资源走 Git LFS ============
*.png       filter=lfs diff=lfs merge=lfs -text
*.jpg       filter=lfs diff=lfs merge=lfs -text
