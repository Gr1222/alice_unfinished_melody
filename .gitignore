# ============ Godot 4 导入缓存 ============
.godot/
/android/

# ============ 导出配置与产物 ============
export.cfg
*.translation
build/
dist/
export/

# 构建产物：渲染输出、打包 zip、demo 视频
# 但 .blend 是「源文件」不是产物，必须保留在版本库里
output/**/*
!output/**/*.blend
*.blend1

# ============ 系统垃圾 ============
.DS_Store
Thumbs.db
desktop.ini
*~

# ============ 编辑器与 IDE ============
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp

# ============ Python 工具脚本 ============
__pycache__/
*.py[cod]
.venv/
venv/

# ============ 本地环境与密钥 ============
.env
.env.*
*.keystore
*.jks

# ============ 来自 GitHub Godot 模板 ============
.nomedia
.import/
export_credentials.cfg
*.tmp
~*.dll
.mono/
mono_crash.*.json
*.exe
